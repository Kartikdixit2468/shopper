# Supabase Postgres connection used by the running application.
# Copy the Session pooler URL from Supabase Dashboard → Connect.
# Keep SSL required; replace every placeholder with the exact values Supabase gives you.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connection_limit=5"

# Connection used by Prisma migrations and other administrative commands.
# Prefer Supabase's direct URL when your machine supports IPv6. If it does not,
# use the Session pooler URL above here as well (without connection_limit).
DIRECT_URL="postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase Dashboard → Project Settings → API Keys.
# The publishable key is browser-safe. Never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Public origin used to build the Supabase PKCE callback URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Temporary product label until the final brand decision is made.
NEXT_PUBLIC_PRODUCT_NAME="Your Storefront"
